function renderFinancialCharts(operations,totalIncome,totalExpense){
  const bar=document.getElementById("incomeExpenseChart");
  const donut=document.getElementById("expenseBreakdownChart");
  if(!bar || !donut) return;
  const max=Math.max(totalIncome,totalExpense,1);
  const incomeH=Math.max(4,Math.round((totalIncome/max)*150));
  const expenseH=Math.max(4,Math.round((totalExpense/max)*150));
  bar.innerHTML=`
    <div class="chart-bar-wrap"><div class="chart-value">${formatMoney(totalIncome)}</div><div class="chart-bar" style="height:${incomeH}px"></div><div class="chart-label">Revenus</div></div>
    <div class="chart-bar-wrap"><div class="chart-value">${formatMoney(totalExpense)}</div><div class="chart-bar expense" style="height:${expenseH}px"></div><div class="chart-label">Dépenses</div></div>`;

  const expenses=operations.filter(o=>o.type==="expense");
  if(!expenses.length){
    donut.innerHTML='<div class="chart-empty">Aucune dépense enregistrée.</div>';
    return;
  }
  const byCat={};
  expenses.forEach(o=>byCat[o.category]=(byCat[o.category]||0)+o.amount);
  const entries=Object.entries(byCat).sort((a,b)=>b[1]-a[1]);
  const total=entries.reduce((s,e)=>s+e[1],0);
  let start=0;
  const segments=[];
  const shades=['#0b6b57','#536071','#19b37a','#7f8c8d','#c0392b','#d4a72c','#34495e','#8e44ad'];
  entries.forEach((e,i)=>{const deg=(e[1]/total)*360;segments.push(`${shades[i%shades.length]} ${start}deg ${start+deg}deg`);start+=deg;});
  const legend=entries.slice(0,6).map((e,i)=>`<div class="legend-item"><span class="legend-dot" style="background:${shades[i%shades.length]}"></span><span>${escapeHtml(e[0])}: ${formatMoney(e[1])}</span></div>`).join('');
  donut.innerHTML=`<div class="donut" style="background:conic-gradient(${segments.join(',')})"></div><div class="legend">${legend}</div>`;
}

function calculateNissaScore(profile,operations,totalIncome,totalExpense,balance){
  let profileScore=(profile && profile.name && profile.business && profile.phone && profile.city && profile.sector && profile.experience && profile.goal)?20:0;
  let incomeScore=totalIncome>0?20:0;
  let expenseScore=totalExpense>0?20:0;
  let historyScore=operations.length>=3?20:operations.length>0?10:0;
  let balanceScore=balance>0?20:0;
  const total=profileScore+incomeScore+expenseScore+historyScore+balanceScore;
  const set=(id,v)=>{const el=document.getElementById(id);if(el)el.innerText=v+"/20";};
  set("scoreProfile",profileScore);set("scoreIncome",incomeScore);set("scoreExpense",expenseScore);set("scoreHistory",historyScore);set("scoreBalance",balanceScore);
  const score=document.getElementById("nissaScore"); if(score)score.innerText=total;
  const msg=document.getElementById("scoreMessage");
  if(msg){msg.innerText=total>=80?"Très bon niveau de préparation financière dans le prototype.":total>=60?"Profil en progression : complète ton historique pour améliorer la qualité des données.":"Commence par compléter ton profil et enregistrer régulièrement tes opérations.";}
}

function analyzeFunding(){
  const amount=parseFloat(document.getElementById("fundingAmount").value)||0;
  const goal=document.getElementById("fundingGoal").value;
  const score=parseInt(document.getElementById("nissaScore").innerText)||0;
  const result=document.getElementById("fundingResult");
  if(!amount){result.innerText="Indique un montant de financement pour lancer l'analyse.";return;}
  let level=score>=80?"Bonne préparation":score>=60?"Préparation intermédiaire":"Préparation à renforcer";
  result.innerHTML="<strong>Analyse :</strong> "+level+".<br>Besoin déclaré : <strong>"+formatMoney(amount)+"</strong> pour <strong>"+escapeHtml(goal)+"</strong>.<br><small>Le prototype recommande de conserver un historique régulier et des informations vérifiables avant toute demande réelle de financement.</small>";
}

function formatMoney(amount){

return new Intl.NumberFormat(
"fr-FR"
).format(amount)+" MRU";

}


/* FORMATAGE DATE */

function formatDate(date){

const parts =
date.split("-");

if(parts.length!==3){

return date;

}

return parts[2]+"/"+parts[1]+"/"+parts[0];

}


/* PROTECTION DU TEXTE */

function escapeHtml(text){

const div =
document.createElement("div");

div.textContent=text;

return div.innerHTML;

}


