<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NISSA FINANCE</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f8f7;
  color:#172033;
  line-height:1.6;
}

header{
  background:#0b172a;
  color:white;
  padding:18px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:10;
}

.logo{
  font-size:24px;
  font-weight:bold;
  color:#19b37a;
}

nav a{
  color:white;
  text-decoration:none;
  margin-left:18px;
  font-size:14px;
}

.hero{
  background:linear-gradient(135deg,#071426,#0b6b57);
  color:white;
  text-align:center;
  padding:85px 7%;
}

.hero h1{
  font-size:48px;
  margin-bottom:15px;
  letter-spacing:2px;
}

.hero p{
  max-width:700px;
  margin:auto;
  font-size:18px;
}

.btn{
  border:none;
  background:#19b37a;
  color:white;
  padding:14px 22px;
  border-radius:9px;
  font-weight:bold;
  cursor:pointer;
  margin-top:22px;
  font-size:16px;
}

.btn:hover{
  opacity:.9;
}

.btn-secondary{
  background:#536071;
}

.btn-danger{
  background:#c0392b;
  padding:8px 12px;
  margin-top:0;
  font-size:13px;
}

section{
  padding:60px 7%;
}

.title{
  text-align:center;
  margin-bottom:35px;
}

.title h2{
  color:#0b6b57;
  font-size:32px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

.card{
  background:white;
  padding:25px;
  border-radius:15px;
  box-shadow:0 5px 20px rgba(0,0,0,.06);
}

.card h3{
  color:#0b6b57;
  margin:10px 0;
}

.icon{
  font-size:35px;
}

.app{
  background:#eaf7f2;
}

.box{
  max-width:900px;
  margin:auto;
  background:white;
  padding:30px;
  border-radius:18px;
  box-shadow:0 5px 25px rgba(0,0,0,.08);
}

.form{
  display:none;
}

.form.active{
  display:block;
}

label{
  display:block;
  margin-top:15px;
  margin-bottom:6px;
  font-weight:bold;
}

input,select,textarea{
  width:100%;
  padding:13px;
  border:1px solid #ccd5df;
  border-radius:8px;
  font-size:16px;
}

textarea{
  min-height:90px;
  resize:vertical;
}

.dashboard{
  display:none;
  max-width:900px;
  margin:auto;
}

.dashboard.active{
  display:block;
}

.welcome{
  background:#0b172a;
  color:white;
  padding:30px;
  border-radius:18px;
  margin-bottom:20px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.stat{
  background:white;
  padding:22px;
  border-radius:14px;
  text-align:center;
  box-shadow:0 5px 20px rgba(0,0,0,.05);
}

.stat strong{
  display:block;
  color:#0b6b57;
  font-size:25px;
}

.financial-box{
  background:white;
  padding:25px;
  border-radius:15px;
  margin-top:20px;
  box-shadow:0 5px 20px rgba(0,0,0,.05);
}

.financial-box h3{
  color:#0b6b57;
  margin-bottom:15px;
}

.profile{
  background:white;
  padding:25px;
  border-radius:14px;
  margin-top:20px;
}

.profile p{
  margin:8px 0;
}

.operations{
  margin-top:20px;
}

.operation{
  background:#f7f9f8;
  border-left:5px solid #19b37a;
  padding:15px;
  border-radius:10px;
  margin-top:10px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
}

.operation.expense{
  border-left-color:#c0392b;
}

.operation-info{
  flex:1;
}

.income{
  color:#0b8f62;
  font-weight:bold;
}

.expense-text{
  color:#c0392b;
  font-weight:bold;
}

.analysis{
  background:#eaf7f2;
  padding:20px;
  border-radius:14px;
  margin-top:20px;
}

.analysis h3{
  color:#0b6b57;
  margin-bottom:10px;
}

footer{
  background:#0b172a;
  color:white;
  text-align:center;
  padding:30px;
}

@media(max-width:800px){

  header{
    flex-direction:column;
    gap:10px;
  }

  nav a{
    margin:0 5px;
  }

  .hero h1{
    font-size:36px;
  }

  .cards{
    grid-template-columns:1fr;
  }

  .stats{
    grid-template-columns:1fr;
  }

  section{
    padding:45px 5%;
  }

  .operation{
    align-items:flex-start;
  }
}

.hero-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;}
.score-display{text-align:center;margin:10px 0 18px;}
.score-display strong{font-size:48px;color:#0b6b57;}
.score-display span{font-size:22px;color:#536071;}
.score-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}
.score-grid div{background:#f5f8f7;padding:12px;border-radius:10px;text-align:center;font-size:13px;}
.score-grid strong{display:block;color:#0b6b57;margin-top:4px;}
.demo-note{font-size:12px;color:#536071;margin-top:15px;}
.funding-result{margin-top:15px;padding:15px;border-radius:10px;background:#eaf7f2;}
@media(max-width:700px){.score-grid{grid-template-columns:repeat(2,1fr);}}


/* GRAPHIQUES V6 */
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px;}
.chart-card{background:white;padding:22px;border-radius:15px;box-shadow:0 5px 20px rgba(0,0,0,.05);}
.chart-card h3{color:#0b6b57;margin:0 0 16px;}
.bar-chart{display:flex;align-items:flex-end;justify-content:space-around;height:190px;gap:18px;padding:10px 8px 0;border-bottom:1px solid #dfe6e2;}
.chart-bar-wrap{height:100%;flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:7px;}
.chart-bar{width:55px;max-width:80%;border-radius:8px 8px 0 0;min-height:4px;background:#0b6b57;transition:height .3s ease;}
.chart-bar.expense{background:#c0392b;}
.chart-label{font-weight:bold;font-size:13px;color:#536071;text-align:center;}
.chart-value{font-weight:bold;font-size:13px;color:#0b172a;}
.donut-wrap{display:flex;align-items:center;justify-content:center;gap:22px;min-height:190px;}
.donut{width:145px;height:145px;border-radius:50%;background:conic-gradient(#0b6b57 0deg 360deg);position:relative;}
.donut:after{content:"";position:absolute;inset:35px;background:white;border-radius:50%;}
.legend{display:flex;flex-direction:column;gap:10px;font-size:13px;}
.legend-item{display:flex;align-items:center;gap:7px;}
.legend-dot{width:10px;height:10px;border-radius:50%;background:#0b6b57;display:inline-block;}
.legend-dot.alt{background:#536071;}
.chart-empty{color:#536071;text-align:center;padding:55px 10px;}
@media(max-width:800px){.charts-grid{grid-template-columns:1fr;}.chart-bar{width:45px;}}

</style>
</head>

