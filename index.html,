<script>

/* AFFICHER L'INSCRIPTION */

function showRegistration(){

document
.getElementById("application")
.scrollIntoView({
behavior:"smooth"
});

}


/* ENREGISTRER LE PROFIL */

function saveProfile(){

const name =
document.getElementById("name").value.trim();

const business =
document.getElementById("business").value.trim();

const phone =
document.getElementById("phone").value.trim();

const city =
document.getElementById("city").value.trim();

const sector =
document.getElementById("sector").value;

const experience =
document.getElementById("experience").value;

const goal =
document.getElementById("goal").value;

if(
!name ||
!business ||
!phone ||
!city ||
!sector ||
!experience ||
!goal
){

alert("Merci de remplir toutes les informations.");
return;

}

const profile = {
name:name,
business:business,
phone:phone,
city:city,
sector:sector,
experience:experience,
goal:goal
};

try {

localStorage.setItem("nissaProfile", JSON.stringify(profile));

const savedProfile = localStorage.getItem("nissaProfile");

if(!savedProfile){
alert("Le profil n'a pas pu être enregistré sur cet appareil.");
return;
}

const status = document.getElementById("saveStatus");
if(status){
status.innerText = "✅ Profil enregistré avec succès.";
status.style.color = "#0b8f62";
}

showDashboard();

} catch(error) {

console.error("Erreur de sauvegarde du profil :", error);

alert(
"Impossible d'enregistrer le profil dans ce navigateur. " +
"Vérifie que les données du site sont autorisées."
);

}

}


/* AFFICHER LE TABLEAU DE BORD */

function showDashboard(){

const data =
JSON.parse(
localStorage.getItem("nissaProfile")
);


if(!data){

return;

}


document.getElementById("dashName")
.innerText=data.name;

document.getElementById("dashBusiness")
.innerText=data.business;

document.getElementById("dashPhone")
.innerText=data.phone;

document.getElementById("dashCity")
.innerText=data.city;

document.getElementById("dashSector")
.innerText=data.sector;

document.getElementById("dashExperience")
.innerText=data.experience;

document.getElementById("dashGoal")
.innerText=data.goal;


document.getElementById("registration")
.classList.remove("active");


document.getElementById("dashboard")
.classList.add("active");


loadOperations();

document.getElementById("application")
.scrollIntoView({
behavior:"smooth"
});

}


/* AJOUTER UNE OPERATION */

function addOperation(){

const type =
document.getElementById("operationType").value;

const amount =
parseFloat(
document.getElementById("operationAmount").value
);

const category =
document.getElementById("operationCategory").value;

const date =
document.getElementById("operationDate").value;

const description =
document.getElementById("operationDescription").value.trim();


if(
!amount ||
amount <= 0 ||
!category ||
!date
){

alert(
"Merci de renseigner le montant, la catégorie et la date."
);

return;

}


const operation={

id:Date.now(),

type:type,

amount:amount,

category:category,

date:date,

description:description

};


let operations =
JSON.parse(
localStorage.getItem("nissaOperations")
) || [];


operations.push(operation);


localStorage.setItem(
"nissaOperations",
JSON.stringify(operations)
);


/* Vider le formulaire */

document.getElementById("operationAmount").value="";

document.getElementById("operationCategory").value="";

document.getElementById("operationDescription").value="";


loadOperations();

}


/* CHARGER LES OPERATIONS */

function loadOperations(){

let operations =
JSON.parse(
localStorage.getItem("nissaOperations")
) || [];


let totalIncome=0;

let totalExpense=0;


operations.forEach(function(operation){

if(operation.type==="income"){

totalIncome += operation.amount;

}else{

totalExpense += operation.amount;

}

});


const balance =
totalIncome-totalExpense;


document.getElementById("totalIncome")
.innerText =
formatMoney(totalIncome);

document.getElementById("totalExpense")
.innerText =
formatMoney(totalExpense);

document.getElementById("balance")
.innerText =
formatMoney(balance);


/* TAUX D'EPARGNE */

let savingRate=0;

if(totalIncome>0){

savingRate =
((balance/totalIncome)*100);

}


document.getElementById("savingRate")
.innerText =
savingRate.toFixed(1)+"%";


/* MESSAGE FINANCIER */

let message="";

if(totalIncome===0){

message=
"Ajoute tes premiers revenus pour commencer ton analyse.";

}else if(balance<0){

message=
"⚠️ Tes dépenses dépassent tes revenus. Surveille ton équilibre financier.";

}else if(savingRate<10){

message=
"Ton solde est positif, mais ta capacité d'épargne reste faible.";

}else if(savingRate<20){

message=
"Bonne progression. Tu commences à construire une capacité d'épargne.";

}else{

message=
"Excellente capacité d'épargne. Ton profil financier progresse bien.";

}


document.getElementById("financialMessage")
.innerText=message;

renderFinancialCharts(operations, totalIncome, totalExpense);

calculateNissaScore(JSON.parse(localStorage.getItem("nissaProfile")) || {}, operations, totalIncome, totalExpense, balance);

/* HISTORIQUE */

const list =
document.getElementById("operationsList");


if(operations.length===0){

list.innerHTML=
"<p>Aucune opération enregistrée pour le moment.</p>";

return;

}


operations.sort(function(a,b){

return b.id-a.id;

});


list.innerHTML="";


operations.forEach(function(operation){

const div =
document.createElement("div");

div.className =
"operation "+
(operation.type==="expense" ? "expense" : "");


const sign =
operation.type==="income" ? "+" : "-";

const amountClass =
operation.type==="income"
? "income"
: "expense-text";


div.innerHTML=`

<div class="operation-info">

<strong>${operation.category}</strong>

<br>

<small>${formatDate(operation.date)}</small>

<br>

${operation.description
? "<small>"+escapeHtml(operation.description)+"</small>"
: ""}

<br>

<span class="${amountClass}">
${sign} ${formatMoney(operation.amount)}
</span>

</div>

<button
class="btn btn-danger"
onclick="deleteOperation(${operation.id})"
>
